    }
  ],
  "item": [
    {
      "name": "1. Criptografia",
      "item": [
        {
          "name": "1.1 Criptografar Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('loginCriptografado', jsonData.criptografado);",
                  "pm.test('Login criptografado com sucesso', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(jsonData.criptografado).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"texto\": \"novo.usuario\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/crypto/encrypt",
              "host": ["{{baseUrl}}"],
              "path": ["api", "crypto", "encrypt"]
            },
            "description": "Criptografa o login para uso nos endpoints"
          },
          "response": []
        },
        {
          "name": "1.2 Criptografar Senha",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('senhaCriptografada', jsonData.criptografado);",
                  "pm.test('Senha criptografada com sucesso', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(jsonData.criptografado).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"texto\": \"MinhaSenha@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/crypto/encrypt",
              "host": ["{{baseUrl}}"],
              "path": ["api", "crypto", "encrypt"]
            },
            "description": "Criptografa a senha para uso nos endpoints"
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Autenticacao JWT",
      "item": [
        {
          "name": "2.1 Registrar Usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                  "pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
                  "pm.test('Usuario registrado com sucesso', function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(jsonData.accessToken).to.be.a('string');",
                  "    pm.expect(jsonData.refreshToken).to.be.a('string');",
                  "    pm.expect(jsonData.tokenType).to.equal('Bearer');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Novo Usuario\",\n  \"loginCriptografado\": \"{{loginCriptografado}}\",\n  \"senhaCriptografada\": \"{{senhaCriptografada}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Registra novo usuario e retorna tokens JWT"
          },
          "response": []
        },
        {
          "name": "2.2 Login - Senha INCORRETA",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Deve retornar erro 401 para senha incorreta', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test('Mensagem de erro', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.include('Credenciais');",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + '/api/crypto/encrypt',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ texto: 'SenhaErrada@999' }) }",
                  "}, function (err, res) {",
                  "    pm.collectionVariables.set('senhaErradaCriptografada', res.json().criptografado);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loginCriptografado\": \"{{loginCriptografado}}\",\n  \"senhaCriptografada\": \"{{senhaErradaCriptografada}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Tenta login com senha incorreta - deve falhar"
          },
          "response": []
        },
        {
          "name": "2.3 Login - Credenciais CORRETAS",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                  "pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
                  "pm.test('Login bem sucedido', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Retorna tokens JWT', function () {",
                  "    pm.expect(jsonData.accessToken).to.be.a('string');",
                  "    pm.expect(jsonData.refreshToken).to.be.a('string');",
                  "    pm.expect(jsonData.tokenType).to.equal('Bearer');",
                  "    pm.expect(jsonData.expiresIn).to.be.a('number');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loginCriptografado\": \"{{loginCriptografado}}\",\n  \"senhaCriptografada\": \"{{senhaCriptografada}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login com credenciais corretas - retorna JWT tokens"
          },
          "response": []
        },
        {
          "name": "2.4 Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                  "pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
                  "pm.test('Token renovado com sucesso', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(jsonData.accessToken).to.be.a('string');",
                  "    pm.expect(jsonData.refreshToken).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            },
            "description": "Renova o access token usando o refresh token"
          },
          "response": []
        },
        {
          "name": "2.5 Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Logout bem sucedido', function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "Faz logout invalidando o refresh token e blacklistando o access token"
          },
          "response": []
        },
        {
          "name": "2.6 Logout All Sessions",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Logout de todas sessoes bem sucedido', function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout-all",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout-all"]
            },
            "description": "Faz logout de todas as sessoes do usuario"
          },
          "response": []
        }
      ]
    },
